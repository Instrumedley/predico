# Heroku config vars (set via `heroku config:set`, not committed as .env)
# DATABASE_URL is set automatically by Heroku Postgres.

ENVIRONMENT=production
DEBUG=False
SECRET_KEY=generate-a-long-random-string

# Heroku Postgres Essential-0 allows 20 connections — keep the pool small.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Frontend URL (Vercel, Cloudflare Pages, etc.)
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# Email via SendGrid (recommended on Heroku)
#   heroku addons:create sendgrid:starter
# Verify a sender in SendGrid, then use that address below.
EMAIL_ENABLED=True
EMAIL_BACKEND=sendgrid
SES_FROM_EMAIL=noreply@yourdomain.com

# SENDGRID_API_KEY is set automatically by the SendGrid add-on.

# Feature flags
# LEAGUE_PROGRESS_CHART_ENABLED=false
# KNOCKOUT_STAGE_ENABLED=false
# KNOCKOUT_STAGE_DEFAULT=false
# DASHBOARD_NEWS_BANNER_ENABLED=false

# Optional: custom domain on Heroku
# ALLOWED_HOSTS=.herokuapp.com,yourdomain.com
