# ==============================================================================
# Local development (copy to .env)
# ==============================================================================
ENVIRONMENT=local
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
DATABASE_URL=postgresql+asyncpg://predico_user:predico_password@localhost:5432/predico_db
REDIS_URL=redis://localhost:6379/0

# Email: logs to console + backend/email_logs/ (no real delivery)
EMAIL_ENABLED=True
EMAIL_BACKEND=local
FRONTEND_URL=http://localhost:3005

# Feature flags
LEAGUE_PROGRESS_CHART_ENABLED=false

# Optional: AWS Cognito (disabled by default)
COGNITO_ENABLED=False

# =============================================================================
# Staging / production on Heroku or AWS (set in platform config — not committed)
# =============================================================================
# Heroku: see docs/HEROKU.md and backend/.env.heroku.example
# AWS (if using archived Terraform): EMAIL_BACKEND=ses
# SES_FROM_EMAIL=noreply@yourdomain.com
# FRONTEND_URL=https://app.yourdomain.com
# AWS_REGION=eu-north-1
