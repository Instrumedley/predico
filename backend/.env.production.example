# Production on Heroku — use `heroku config:set`, not a committed .env file.

# Full guide: docs/HEROKU.md

# Template: backend/.env.heroku.example



ENVIRONMENT=production

DEBUG=False



EMAIL_ENABLED=True

EMAIL_BACKEND=sendgrid

SES_FROM_EMAIL=noreply@yourdomain.com

FRONTEND_URL=https://your-app.vercel.app

CORS_ORIGINS=https://your-app.vercel.app



# DATABASE_URL, SECRET_KEY, SENDGRID_API_KEY: set on Heroku (not committed)

